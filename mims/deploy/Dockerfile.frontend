# ============================================================
# M-IMS Frontend — Production Dockerfile (Multi-stage)
# ============================================================

# ─── Stage 1: Builder ───────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /build

# Build args for production URLs
ARG NEXT_PUBLIC_API_URL=http://localhost:3001
ARG NEXTAUTH_URL=http://localhost:3000
ARG NEXTAUTH_SECRET

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXTAUTH_URL=$NEXTAUTH_URL
ENV NEXTAUTH_SECRET=$NEXTAUTH_SECRET

COPY frontend/package*.json ./
# Install ALL deps (including devDependencies needed for the build: postcss, autoprefixer, etc.)
# NODE_ENV is intentionally NOT set to production here so npm ci includes devDeps
RUN npm ci

ENV NODE_ENV=production

COPY frontend/ ./

# Build production bundle (no source maps, console.log removed)
RUN npm run build

# ─── Stage 2: Production Runtime ────────────────────────────
FROM node:20-alpine AS production

RUN addgroup -g 1001 -S mims && adduser -S mims -u 1001 -G mims

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000

# Copy ONLY the production build output — no source files
COPY --from=builder --chown=mims:mims /build/.next/standalone ./
COPY --from=builder --chown=mims:mims /build/.next/static ./.next/static
COPY --from=builder --chown=mims:mims /build/public ./public

EXPOSE 3000

USER mims

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD wget -qO- http://localhost:3000/ || exit 1

CMD ["node", "server.js"]
