# ========================================
# M-IMS Backend Environment Variables
# ========================================

# Application Configuration
NODE_ENV=development
PORT=3001

# Frontend URL
FRONTEND_URL=http://localhost:3000
API_PREFIX=api/v1

# Database Configuration
# PERFORMANCE OPTIMIZATION: Connection pooling settings added
# connection_limit: Max number of database connections (default: num_cpus * 2 + 1)
# pool_timeout: Max time to wait for connection from pool (seconds)
# connect_timeout: Max time to wait for new connection (seconds)
DATABASE_URL=postgresql://postgres:password@localhost:5432/mims_db?connection_limit=20&pool_timeout=10&connect_timeout=10
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=mims_db
DB_SCHEMA=public
DB_SSL=false

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-super-secure-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=7d

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# File Storage Configuration
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=mims-files

# Hospital Configuration
HOSPITAL_TIMEZONE=UTC
HOSPITAL_LOCALE=en-US

# FIFO Allocation Configuration
FIFO_ALLOCATION_ENABLED=true
AUTO_REDISTRIBUTION_ENABLED=true
REDISTRIBUTION_INTERVAL_MINUTES=60

# Offline Sync Configuration
OFFLINE_SYNC_ENABLED=true
SYNC_INTERVAL_MINUTES=15

# Security
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM_COST=4

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Logging
LOG_LEVEL=info
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs/app.log

# Health Check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_DATABASE_ENABLED=true
HEALTH_CHECK_REDIS_ENABLED=true
