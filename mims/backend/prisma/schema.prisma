model PayrollSetting {
  id              String          @id @default(uuid())
  hospitalId      String          @map("hospital_id")
  userId          String          @unique @map("user_id")
  monthlySalary   Decimal         @map("monthly_salary") @db.Decimal(12,2)
  allowanceAmount Decimal         @default(0) @map("allowance_amount") @db.Decimal(12,2)
  otherDeductionAmount Decimal    @default(0) @map("other_deduction_amount") @db.Decimal(12,2)
  latePenaltyType LatePenaltyType @map("late_penalty_type")
  leavePayType    LeavePayType    @map("leave_pay_type")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@map("payroll_settings")
}

model PayrollRecord {
  id                   String   @id @default(uuid())
  hospitalId           String   @map("hospital_id")
  userId               String   @map("user_id")
  year                 Int
  month                Int
  monthlySalary        Decimal  @map("monthly_salary") @db.Decimal(12,2)
  allowanceAmount      Decimal  @map("allowance_amount") @db.Decimal(12,2)
  otherDeductionAmount Decimal  @map("other_deduction_amount") @db.Decimal(12,2)
  totalPresent         Int      @map("total_present")
  totalAbsent          Int      @map("total_absent")
  totalLate            Int      @map("total_late")
  totalHalfDay         Int      @map("total_half_day")
  totalLeave           Int      @map("total_leave")
  netPay               Decimal  @map("net_pay") @db.Decimal(12,2)
  generatedAt          DateTime @default(now()) @map("generated_at")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, userId, year, month])
  @@index([hospitalId, year, month])
  @@map("payroll_records")
}

enum ExpenditureType {
  DAILY_WAGES
  ELECTRICITY
  MAINTENANCE
  PURCHASE
  MISCELLANEOUS
  RENT
  SUPPLIES
  OTHER
}

model Expenditure {
  id          String           @id @default(uuid())
  hospitalId  String           @map("hospital_id")
  date        DateTime
  type        ExpenditureType
  amount      Decimal          @db.Decimal(12,2)
  description String?
  createdBy   String           @map("created_by")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  creator  User     @relation("ExpenditureCreator", fields: [createdBy], references: [id])

  @@index([hospitalId, date])
  @@index([hospitalId, type])
  @@map("expenditures")
}
