// LAB SERVICES - PHASE 3
// ============================================

model LabTest {
  id              String        @id @default(uuid())
  hospitalId      String        @map("hospital_id")
  departmentId    String?       @map("department_id")
  subDepartmentId String?       @map("sub_department_id")
  testCode        String        @map("test_code")
  testName        String        @map("test_name")
  testCategory    String        @map("test_category") // e.g., "Hematology", "Biochemistry", "Microbiology"
  description     String?
  price           Float         @default(0)
  turnaroundTime  String?       @map("turnaround_time") // e.g., "2-4 hours", "24 hours"
  requirements    String? // Sample requirements, fasting, etc.
  normalRange     Json? // Store normal ranges for different age groups/genders
  status          LabTestStatus @default(ACTIVE)
  version         Int           @default(1)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  // Relations
  hospital      Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  department    Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  subDepartment SubDepartment? @relation(fields: [subDepartmentId], references: [id], onDelete: SetNull)
  labOrders     LabOrder[]

  @@unique([hospitalId, testCode])
  @@index([hospitalId])
  @@index([departmentId])
  @@index([subDepartmentId])
  @@index([testCategory])
  @@index([status])
  @@map("lab_tests")
}

model LabOrder {
  id                  String         @id @default(uuid())
  hospitalId          String         @map("hospital_id")
  patientId           String         @map("patient_id")
  visitId             String?        @map("visit_id")
  labTestId           String         @map("lab_test_id")
  orderNumber         String         @map("order_number")
  orderedById         String         @map("ordered_by_id")
  priority            TestPriority   @default(ROUTINE)
  clinicalNotes       String?        @map("clinical_notes")
  status              LabOrderStatus @default(PENDING)
  // Sample Collection
  sampleCollectedAt   DateTime?      @map("sample_collected_at")
  sampleCollectedById String?        @map("sample_collected_by_id")
  sampleType          String?        @map("sample_type") // e.g., "Blood", "Urine", "Serum"
  sampleNotes         String?        @map("sample_notes")
  // Result Entry
  resultsEnteredAt    DateTime?      @map("results_entered_at")
  resultsEnteredById  String?        @map("results_entered_by_id")
  results             Json? // Structured result data
  resultNotes         String?        @map("result_notes")
  resultFiles         Json? // Array of file URLs for images, PDFs
  // Result Approval
  resultsApprovedAt   DateTime?      @map("results_approved_at")
  resultsApprovedById String?        @map("results_approved_by_id")
  approvalNotes       String?        @map("approval_notes")
  // Payment
  paymentStatus       String         @default("PENDING") @map("payment_status") // PENDING, PAID, WAIVED
  amountPaid          Float          @default(0) @map("amount_paid")
  // Metadata
  version             Int            @default(1)
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  // Relations
  hospital          Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient           Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visit             Visit?   @relation(fields: [visitId], references: [id], onDelete: SetNull)
  labTest           LabTest  @relation(fields: [labTestId], references: [id], onDelete: Restrict)
  orderedBy         User     @relation("LabOrderingDoctor", fields: [orderedById], references: [id], onDelete: Restrict)
  sampleCollectedBy User?    @relation("LabSampleCollector", fields: [sampleCollectedById], references: [id], onDelete: SetNull)
  resultsEnteredBy  User?    @relation("LabResultEnterer", fields: [resultsEnteredById], references: [id], onDelete: SetNull)
  resultsApprovedBy User?    @relation("LabResultApprover", fields: [resultsApprovedById], references: [id], onDelete: SetNull)

  @@unique([hospitalId, orderNumber])
  @@index([hospitalId])
  @@index([patientId])
  @@index([visitId])
  @@index([labTestId])
  @@index([orderedById])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@map("lab_orders")
}

