// ============================================
// FEATURE FLAGS
// ============================================

model FeatureFlag {
  id          String   @id @default(uuid())
  hospitalId  String?  @map("hospital_id") // NULL = global flag
  key         String // e.g., "clinical_module", "billing_module"
  enabled     Boolean  @default(false)
  description String?
  metadata    Json? // Additional config: { rolloutPercent: 50, allowedRoles: [...] }
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  hospital Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, key]) // Unique per hospital (or global if null)
  @@index([key])
  @@index([hospitalId])
  @@map("feature_flags")
}

// ============================================
// PERMISSIONS & RBAC
// ============================================

model Permission {
  id          String   @id @default(uuid())
  resource    String // e.g., "medicines", "inventory", "patients", "transfers"
  action      String // e.g., "read", "write", "delete", "approve"
  scope       String   @default("all") // e.g., "all", "own_pharmacy", "own_department"
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  rolePermissions RolePermission[]

  @@unique([resource, action, scope]) // Unique permission
  @@index([resource])
  @@index([action])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  role         UserRole
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId]) // Prevent duplicate role-permission mapping
  @@index([role])
  @@index([permissionId])
  @@map("role_permissions")
}

