// M-IMS Database Schema
// Hospital Medicine Inventory Management System
// Multi-tenant architecture with hospital_id scoping

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// CORE ENTITIES
// ============================================

model Hospital {
  id        String         @id @default(uuid())
  name      String
  code      String         @unique
  address   String?
  phone     String?
  email     String?
  status    HospitalStatus @default(ACTIVE)
  version   Int            @default(1)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  // Relations
  users              User[]
  departments        Department[]
  pharmacies         Pharmacy[]
  patients           Patient[]
  medicines          Medicine[]
  stockBatches       StockBatch[]
  purchaseOrders     PurchaseOrder[]
  grns               GRN[]
  prescriptions      Prescription[]
  issueTransactions  IssueTransaction[]
  transferRequests   TransferRequest[]   @relation("HospitalTransfers")
  returnTransactions ReturnTransaction[]
  alerts             Alert[]
  auditLogs          AuditLog[]
  syncOperations     SyncOperation[]
  systemConfigs      SystemConfig[]
  featureFlags       FeatureFlag[]
  threatAlerts       ThreatAlert[]
  // Phase 2: Clinical Services
  clinics            Clinic[]
  visits             Visit[]
  tokens             Token[]
  referrals          Referral[]
  receipts           Receipt[]
  rooms              Room[]
  beds               Bed[]
  admissions         Admission[]
  dailyCharges       DailyCharge[]
  operationTheatres  OperationTheatre[]
  operations         Operation[]
  // Phase 3: Lab Services
  labTests           LabTest[]
  labOrders          LabOrder[]
  // Attendance Module
  biometricDevices   BiometricDevice[]
  biometricEnrollments BiometricEnrollment[]
  attendanceLogs     AttendanceLog[]
  attendanceRecords  AttendanceRecord[]
  shifts             Shift[]
  employeeShifts     EmployeeShift[]
  leaveTypes         LeaveType[]
  leaves             Leave[]
  holidays           Holiday[]
  deviceSyncLogs     DeviceSyncLog[]
  attendanceConfigs  AttendanceConfig[]
  payrollSettings    PayrollSetting[]
  payrollRecords     PayrollRecord[]
  expenditures       Expenditure[]

  @@map("hospitals")
}

model Department {
  id          String           @id @default(uuid())
  hospitalId  String           @map("hospital_id")
  name        String // e.g., "Radiology", "Cardiology", "Emergency"
  code        String // e.g., "RAD", "CARD", "EMER"
  description String?
  status      DepartmentStatus @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  // Relations
  hospital         Hospital        @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  subDepartments   SubDepartment[]
  users            User[]          @relation("DepartmentUsers")
  departmentAdmins User[]          @relation("DepartmentAdmins")
  // Phase 2: Clinical Services
  clinics          Clinic[]
  visits           Visit[]
  referralsFrom    Referral[]      @relation("ReferralsFrom")
  referralsTo      Referral[]      @relation("ReferralsTo")
  receipts         Receipt[]
  rooms            Room[]
  beds             Bed[]
  admissions       Admission[]
  operationTheatres OperationTheatre[]
  operations        Operation[]
  // Phase 3: Lab Services
  labTests         LabTest[]

  @@unique([hospitalId, code]) // Unique department code per hospital
  @@index([hospitalId])
  @@index([status])
  @@map("departments")
}

model SubDepartment {
  id           String              @id @default(uuid())
  departmentId String              @map("department_id")
  name         String // e.g., "X-ray", "Ultrasound", "CT Scan"
  code         String // e.g., "XRAY", "US", "CT"
  description  String?
  status       SubDepartmentStatus @default(ACTIVE)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  // Relations
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  users      User[]     @relation("SubDepartmentUsers")
  // Phase 3: Lab Services
  labTests   LabTest[]

  @@unique([departmentId, code]) // Unique sub-department code per department
  @@index([departmentId])
  @@index([status])
  @@map("sub_departments")
}

model User {
  id                  String     @id @default(uuid())
  hospitalId          String?    @map("hospital_id") // NULL for SUPER_ADMIN and MASTER_ADMIN, required for all other roles
  pharmacyId          String?    @map("pharmacy_id")
  departmentId        String?    @map("department_id") // Department assignment for department-scoped users
  subDepartmentId     String?    @map("sub_department_id") // Sub-department assignment for specialized users
  managedDepartmentId String?    @map("managed_department_id") // For DEPARTMENT_ADMIN role
  email               String     @unique
  passwordHash        String     @map("password_hash")
  fullName            String     @map("full_name")
  role                UserRole
  phone               String?
  status              UserStatus @default(ACTIVE)
  mfaEnabled          Boolean    @default(false) @map("mfa_enabled")
  mfaSecret           String?    @map("mfa_secret")
  resetToken          String?    @map("reset_token")
  resetTokenExpiry    DateTime?  @map("reset_token_expiry")
  lastLogin           DateTime?  @map("last_login")
  version             Int        @default(1)
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  // Relations
  hospital              Hospital?           @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  pharmacy              Pharmacy?           @relation(fields: [pharmacyId], references: [id], onDelete: SetNull)
  department            Department?         @relation("DepartmentUsers", fields: [departmentId], references: [id], onDelete: SetNull)
  subDepartment         SubDepartment?      @relation("SubDepartmentUsers", fields: [subDepartmentId], references: [id], onDelete: SetNull)
  managedDepartment     Department?         @relation("DepartmentAdmins", fields: [managedDepartmentId], references: [id], onDelete: SetNull)
  patientsRegistered    Patient[]           @relation("RegisteredBy")
  attendingPatients     Patient[]           @relation("AttendingDoctor")
  prescriptions         Prescription[]
  issueTransactions     IssueTransaction[]
  transferRequestsMade  TransferRequest[]   @relation("TransferRequester")
  transfersApproved     TransferRequest[]   @relation("TransferApprover")
  transfersReceived     TransferRequest[]   @relation("TransferReceiver")
  returnTransactions    ReturnTransaction[]
  purchaseOrdersCreated PurchaseOrder[]
  grnsReceived          GRN[]
  alertsAcknowledged    Alert[]
  auditLogs             AuditLog[]
  // Phase 2: Clinical Services
  clinics               Clinic[]            @relation("DoctorClinics")
  visitsRegistered      Visit[]             @relation("VisitRegistrar")
  visitsConsulted       Visit[]             @relation("VisitConsultant")
  visitsAttended        Visit[]             @relation("VisitAttendingDoctor")
  referralsMade         Referral[]          @relation("ReferralsMade")
  receiptsGenerated     Receipt[]           @relation("ReceiptsGenerated")
  attendingAdmissions   Admission[]         @relation("AttendingAdmissions")
  admittingAdmissions   Admission[]         @relation("AdmittingAdmissions")
  dischargingAdmissions Admission[]         @relation("DischargingAdmissions")
  operationsAsSurgeon    Operation[]         @relation("OperationSurgeon")
  // Phase 3: Lab Services
  labOrdersMade         LabOrder[]          @relation("LabOrderingDoctor")
  labSamplesCollected   LabOrder[]          @relation("LabSampleCollector")
  labResultsEntered     LabOrder[]          @relation("LabResultEnterer")
  labResultsApproved    LabOrder[]          @relation("LabResultApprover")
  prescriptionMedicinesAdded PrescriptionMedicine[] @relation("PrescriptionMedicineAdder")
  prescriptionDispatches     PrescriptionDispatch[] @relation("PrescriptionDispatcher")
  // Attendance Module
  biometricEnrollments  BiometricEnrollment[]
  attendanceLogs        AttendanceLog[]
  attendanceRecords     AttendanceRecord[]
  employeeShifts        EmployeeShift[]
  shiftsAssignedBy      EmployeeShift[]     @relation("EmployeeShiftAssignedBy")
  leaves                Leave[]
  leaveReviews          Leave[]             @relation("LeaveReviewedBy")
  payrollSetting        PayrollSetting?
  payrollRecords        PayrollRecord[]
  markedAttendance      AttendanceRecord[]  @relation("MarkedAttendance")
  // Security: Threat Detection & Alerts
  threatAlerts          ThreatAlert[]
  threatAlertsAsAdmin   ThreatAlert[]       @relation("AdminAlerts")
  // Expenditure Management
  expenditures          Expenditure[]       @relation("ExpenditureCreator")

  @@index([hospitalId])
  @@index([pharmacyId])
  @@index([departmentId])
  @@index([subDepartmentId])
  @@index([email])
  @@index([role])
  @@map("users")
}

model Pharmacy {
  id           String         @id @default(uuid())
  hospitalId   String         @map("hospital_id")
  name         String
  code         String
  type         PharmacyType
  locationWard String?        @map("location_ward")
  status       PharmacyStatus @default(ACTIVE)
  version      Int            @default(1)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  // Relations
  hospital           Hospital            @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  users              User[]
  stockBatches       StockBatch[]
  purchaseOrders     PurchaseOrder[]
  grns               GRN[]
  issueTransactions  IssueTransaction[]
  transfersFrom      TransferRequest[]   @relation("FromPharmacy")
  transfersTo        TransferRequest[]   @relation("ToPharmacy")
  returnTransactions ReturnTransaction[]
  alerts             Alert[]
  syncOperations     SyncOperation[]

  @@unique([hospitalId, code])
  @@index([hospitalId])
  @@index([type])
  @@map("pharmacies")
}

// ============================================
// PATIENT MANAGEMENT
// ============================================

model Patient {
  id                String    @id @default(uuid())
  hospitalId        String    @map("hospital_id")
  nrNumber          String    @unique @map("nr_number")
  fullName          String    @map("full_name")
  mobile            String?
  cnic              String? // Encrypted
  dob               DateTime?
  gender            Gender
  address           String?
  visitType         VisitType @map("visit_type")
  department        String?
  ward              String?
  bed               String?
  attendingDoctorId String?   @map("attending_doctor_id")
  registeredBy      String    @map("registered_by")
  version           Int       @default(1)
  registeredAt      DateTime  @default(now()) @map("registered_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Relations
  hospital           Hospital            @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  attendingDoctor    User?               @relation("AttendingDoctor", fields: [attendingDoctorId], references: [id])
  registeredByUser   User                @relation("RegisteredBy", fields: [registeredBy], references: [id])
  prescriptions      Prescription[]
  issueTransactions  IssueTransaction[]
  returnTransactions ReturnTransaction[]
  // Phase 2: Clinical Services
  visits             Visit[]
  receipts           Receipt[]
  admissions         Admission[]
  operations         Operation[]
  // Phase 3: Lab Services
  labOrders          LabOrder[]

  @@index([hospitalId])
  @@index([nrNumber])
  @@index([mobile])
  @@index([registeredAt])
  @@map("patients")
}

// ============================================
// MEDICINE MANAGEMENT
// ============================================

model Medicine {
  id           String         @id @default(uuid())
  hospitalId   String         @map("hospital_id")
  name         String
  genericName  String?        @map("generic_name")
  strength     String?
  form         MedicineForm
  manufacturer String?
  quantityPerPack Int?        @map("quantity_per_pack")   // tablets per strip
  stripsPerBox    Int?        @map("strips_per_box")      // strips per box (for tablets/capsules)
  status       MedicineStatus @default(ACTIVE)
  version      Int            @default(1)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  // Relations
  hospital          Hospital              @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  stockBatches      StockBatch[]
  poItems           PurchaseOrderItem[]
  grnItems          GRNItem[]
  prescriptionItems     PrescriptionItem[]
  prescriptionMedicines PrescriptionMedicine[]
  issueItems            IssueItem[]
  transferItems     TransferItem[]
  returnItems       ReturnItem[]
  alternativesFor   MedicineAlternative[] @relation("MainMedicine")
  alternatives      MedicineAlternative[] @relation("AlternativeMedicine")

  @@index([hospitalId])
  @@index([name])
  @@index([genericName])
  @@index([form])
  @@index([manufacturer])
  @@index([status])
  @@index([hospitalId, status]) // Composite for common queries
  @@map("medicines")
}

model MedicineAlternative {
  id                    String   @id @default(uuid())
  medicineId            String   @map("medicine_id")
  alternativeMedicineId String   @map("alternative_medicine_id")
  createdAt             DateTime @default(now()) @map("created_at")

  // Relations
  medicine            Medicine @relation("MainMedicine", fields: [medicineId], references: [id], onDelete: Cascade)
  alternativeMedicine Medicine @relation("AlternativeMedicine", fields: [alternativeMedicineId], references: [id], onDelete: Cascade)

  @@unique([medicineId, alternativeMedicineId])
  @@map("medicine_alternatives")
}

// ============================================
// INVENTORY MANAGEMENT
// ============================================

model StockBatch {
  id              String      @id @default(uuid())
  hospitalId      String      @map("hospital_id")
  pharmacyId      String      @map("pharmacy_id")
  medicineId      String      @map("medicine_id")
  batchNo         String      @map("batch_no")
  qtyReceived     Int         @map("qty_received")
  qtyAvailable    Int         @map("qty_available")
  expiryDate      DateTime    @map("expiry_date")
  manufacturer    String?
  storageType     StorageType @map("storage_type")
  purchasePrice   Decimal     @map("purchase_price") @db.Decimal(10, 2)
  governmentPrice Decimal     @map("government_price") @db.Decimal(10, 2)
  retailPrice     Decimal     @map("retail_price") @db.Decimal(10, 2)
  receivedDate    DateTime    @default(now()) @map("received_date")
  status          BatchStatus @default(AVAILABLE)
  category        BatchCategory @default(NORMAL)
  version         Int         @default(1)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  // Unit-based tracking fields
  purchaseUnit          String?     @map("purchase_unit")           // e.g., Box, Bottle, Carton
  purchaseUnitPrice     Decimal?    @map("purchase_unit_price") @db.Decimal(10, 2) // price per purchase unit
  unitsPerPurchaseUnit  Int         @default(1) @map("units_per_purchase_unit")    // e.g., 1 Box = 10 Strips
  subUnit               String?     @map("sub_unit")                // e.g., Strip, Vial (middle level)
  unitsPerSubUnit       Int         @default(1) @map("units_per_sub_unit")         // e.g., 1 Strip = 10 Tablets
  dispensingUnit        String?     @map("dispensing_unit")          // e.g., Tablet, ml, Vial
  qtyReceivedPurchase   Int?        @map("qty_received_purchase")   // quantity received in purchase units
  qtyAvailableDispensing Int?       @map("qty_available_dispensing") // auto-calculated total dispensing units
  costPerDispensingUnit Decimal?    @map("cost_per_dispensing_unit") @db.Decimal(10, 4) // auto-calculated
  reorderLevel          Int         @default(10) @map("reorder_level") // min dispensing units before alert

  // Relations
  hospital                    Hospital               @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  pharmacy                    Pharmacy               @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  medicine                    Medicine               @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  issueItems                  IssueItem[]
  returnItems                 ReturnItem[]
  transferBatchMappingsSource TransferBatchMapping[] @relation("SourceBatch")
  transferBatchMappingsDest   TransferBatchMapping[] @relation("DestinationBatch")
  grnItems                    GRNItem[]

  @@index([hospitalId])
  @@index([pharmacyId])
  @@index([medicineId])
  @@index([batchNo])
  @@index([expiryDate])
  @@index([status])
  @@index([receivedDate])
  @@index([pharmacyId, medicineId]) // Composite for inventory queries
  @@index([pharmacyId, status]) // Composite for active stock
  @@index([pharmacyId, medicineId, status]) // Triple composite for filtered inventory
  @@index([pharmacyId, expiryDate]) // For expiry alerts
  @@index([medicineId, expiryDate, status]) // For medicine-specific expiry queries
  @@index([pharmacyId, status, qtyAvailableDispensing]) // For low-stock alerts with unit tracking
  @@index([hospitalId, category]) // For category tab filtering
  @@map("stock_batches")
}

// ============================================
// PURCHASE ORDER & GRN
// ============================================

model PurchaseOrder {
  id            String   @id @default(uuid())
  hospitalId    String   @map("hospital_id")
  pharmacyId    String   @map("pharmacy_id")
  poNumber      String   @unique @map("po_number")
  vendorName    String?  @map("vendor_name")
  vendorContact String?  @map("vendor_contact")
  totalAmount   Decimal  @map("total_amount") @db.Decimal(12, 2)
  status        POStatus @default(DRAFT)
  createdBy     String   @map("created_by")
  version       Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  hospital Hospital            @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  pharmacy Pharmacy            @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  creator  User                @relation(fields: [createdBy], references: [id])
  items    PurchaseOrderItem[]
  grns     GRN[]

  @@index([hospitalId])
  @@index([pharmacyId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id         String  @id @default(uuid())
  poId       String  @map("po_id")
  medicineId String  @map("medicine_id")
  qtyOrdered Int     @map("qty_ordered")
  unitPrice  Decimal @map("unit_price") @db.Decimal(10, 2)
  totalPrice Decimal @map("total_price") @db.Decimal(10, 2)

  // Relations
  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  medicine      Medicine      @relation(fields: [medicineId], references: [id])

  @@index([poId])
  @@map("purchase_order_items")
}

model GRN {
  id           String   @id @default(uuid())
  hospitalId   String   @map("hospital_id")
  poId         String   @map("po_id")
  pharmacyId   String   @map("pharmacy_id")
  grnNumber    String   @unique @map("grn_number")
  receivedDate DateTime @default(now()) @map("received_date")
  receivedBy   String   @map("received_by")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  hospital      Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id])
  pharmacy      Pharmacy      @relation(fields: [pharmacyId], references: [id])
  receiver      User          @relation(fields: [receivedBy], references: [id])
  items         GRNItem[]

  @@index([hospitalId])
  @@index([pharmacyId])
  @@map("grns")
}

model GRNItem {
  id          String @id @default(uuid())
  grnId       String @map("grn_id")
  medicineId  String @map("medicine_id")
  batchId     String @map("batch_id")
  qtyReceived Int    @map("qty_received")

  // Relations
  grn      GRN        @relation(fields: [grnId], references: [id], onDelete: Cascade)
  medicine Medicine   @relation(fields: [medicineId], references: [id])
  batch    StockBatch @relation(fields: [batchId], references: [id])

  @@index([grnId])
  @@map("grn_items")
}

// ============================================
// PRESCRIPTION MANAGEMENT
// ============================================

model Prescription {
  id               String             @id @default(uuid())
  hospitalId       String             @map("hospital_id")
  nrNumber         String             @map("nr_number")
  doctorId         String?            @map("doctor_id")
  visitId          String?            @map("visit_id")
  prescriptionType PrescriptionType   @map("prescription_type")
  scannedImageUrl  String?            @map("scanned_image_url")
  status           PrescriptionStatus @default(ACTIVE)
  notes            String?
  version          Int                @default(1)
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  // Relations
  hospital          Hospital              @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient           Patient               @relation(fields: [nrNumber], references: [nrNumber])
  doctor            User?                 @relation(fields: [doctorId], references: [id])
  visit             Visit?                @relation(fields: [visitId], references: [id], onDelete: SetNull)
  items             PrescriptionItem[]
  medicines         PrescriptionMedicine[]
  dispatches        PrescriptionDispatch[]
  issueTransactions IssueTransaction[]

  @@index([hospitalId])
  @@index([nrNumber])
  @@index([doctorId])
  @@index([visitId])
  @@index([status])
  @@map("prescriptions")
}

model PrescriptionItem {
  id               String                 @id @default(uuid())
  prescriptionId   String                 @map("prescription_id")
  medicineId       String                 @map("medicine_id")
  qtyPrescribed    Int                    @map("qty_prescribed")
  dosage           String?
  frequency        String?
  duration         String?
  status           PrescriptionItemStatus @default(PENDING)
  transferCategory BatchCategory          @default(NORMAL) @map("transfer_category")

  // Relations
  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicine     Medicine     @relation(fields: [medicineId], references: [id])

  @@index([prescriptionId])
  @@map("prescription_items")
}

model PrescriptionMedicine {
  id              String           @id @default(uuid())
  prescriptionId  String           @map("prescription_id")
  medicineId      String           @map("medicine_id")
  dosage          String?
  dosageFrequency DosageFrequency? @map("dosage_frequency")
  instructions    String?
  category        BatchCategory    @default(NORMAL)
  addedBy         String           @map("added_by")
  addedAt         DateTime         @default(now()) @map("added_at")

  prescription  Prescription              @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicine      Medicine                  @relation(fields: [medicineId], references: [id])
  addedByUser   User                      @relation("PrescriptionMedicineAdder", fields: [addedBy], references: [id])
  dispatchItems PrescriptionDispatchItem[]

  @@index([prescriptionId])
  @@map("prescription_medicines")
}

model PrescriptionDispatch {
  id             String   @id @default(uuid())
  prescriptionId String   @map("prescription_id")
  visitId        String?  @map("visit_id")
  dispatchedBy   String   @map("dispatched_by")
  dispatchedAt   DateTime @default(now()) @map("dispatched_at")
  notes          String?

  prescription Prescription              @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  visit        Visit?                    @relation(fields: [visitId], references: [id], onDelete: SetNull)
  dispatcher   User                      @relation("PrescriptionDispatcher", fields: [dispatchedBy], references: [id])
  items        PrescriptionDispatchItem[]

  @@index([prescriptionId])
  @@map("prescription_dispatches")
}

model PrescriptionDispatchItem {
  id                     String @id @default(uuid())
  dispatchId             String @map("dispatch_id")
  prescriptionMedicineId String @map("prescription_medicine_id")
  quantityDispatched     Int    @map("quantity_dispatched")

  dispatch             PrescriptionDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  prescriptionMedicine PrescriptionMedicine @relation(fields: [prescriptionMedicineId], references: [id])

  @@index([dispatchId])
  @@map("prescription_dispatch_items")
}

// ============================================
// ISSUANCE & RETURNS
// ============================================

model IssueTransaction {
  id             String                 @id @default(uuid())
  hospitalId     String                 @map("hospital_id")
  pharmacyId     String                 @map("pharmacy_id")
  nrNumber       String                 @map("nr_number")
  prescriptionId String?                @map("prescription_id")
  issuedBy       String                 @map("issued_by")
  totalAmount    Decimal                @map("total_amount") @db.Decimal(10, 2)
  priceType      PriceType              @map("price_type")
  status         IssueTransactionStatus @default(COMPLETED)
  version        Int                    @default(1)
  issuedAt       DateTime               @default(now()) @map("issued_at")
  receiptUrl     String?                @map("receipt_url")

  // Relations
  hospital           Hospital            @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  pharmacy           Pharmacy            @relation(fields: [pharmacyId], references: [id])
  patient            Patient             @relation(fields: [nrNumber], references: [nrNumber])
  prescription       Prescription?       @relation(fields: [prescriptionId], references: [id])
  issuer             User                @relation(fields: [issuedBy], references: [id])
  items              IssueItem[]
  returnTransactions ReturnTransaction[]

  @@index([hospitalId])
  @@index([pharmacyId])
  @@index([nrNumber])
  @@index([issuedAt])
  @@map("issue_transactions")
}

model IssueItem {
  id         String  @id @default(uuid())
  issueId    String  @map("issue_id")
  batchId    String  @map("batch_id")
  medicineId String  @map("medicine_id")
  qtyIssued  Int     @map("qty_issued")
  unitPrice  Decimal @map("unit_price") @db.Decimal(10, 2)
  totalPrice Decimal @map("total_price") @db.Decimal(10, 2)

  // Relations
  issueTransaction IssueTransaction @relation(fields: [issueId], references: [id], onDelete: Cascade)
  batch            StockBatch       @relation(fields: [batchId], references: [id])
  medicine         Medicine         @relation(fields: [medicineId], references: [id])

  @@index([issueId])
  @@map("issue_items")
}

model ReturnTransaction {
  id         String     @id @default(uuid())
  hospitalId String     @map("hospital_id")
  pharmacyId String     @map("pharmacy_id")
  nrNumber   String?    @map("nr_number")
  issueId    String?    @map("issue_id")
  returnType ReturnType @map("return_type")
  reason     String
  returnedBy String     @map("returned_by")
  version    Int        @default(1)
  returnedAt DateTime   @default(now()) @map("returned_at")

  // Relations
  hospital         Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  pharmacy         Pharmacy          @relation(fields: [pharmacyId], references: [id])
  patient          Patient?          @relation(fields: [nrNumber], references: [nrNumber])
  issueTransaction IssueTransaction? @relation(fields: [issueId], references: [id])
  returnedByUser   User              @relation(fields: [returnedBy], references: [id])
  items            ReturnItem[]

  @@index([hospitalId])
  @@index([pharmacyId])
  @@map("return_transactions")
}

model ReturnItem {
  id           String          @id @default(uuid())
  returnId     String          @map("return_id")
  batchId      String          @map("batch_id")
  medicineId   String          @map("medicine_id")
  qtyReturned  Int             @map("qty_returned")
  refundAmount Decimal         @map("refund_amount") @db.Decimal(10, 2)
  condition    ReturnCondition

  // Relations
  returnTransaction ReturnTransaction @relation(fields: [returnId], references: [id], onDelete: Cascade)
  batch             StockBatch        @relation(fields: [batchId], references: [id])
  medicine          Medicine          @relation(fields: [medicineId], references: [id])

  @@index([returnId])
  @@map("return_items")
}

// ============================================
// TRANSFER MANAGEMENT
// ============================================

model TransferRequest {
  id             String         @id @default(uuid())
  hospitalId     String         @map("hospital_id")
  fromPharmacyId String         @map("from_pharmacy_id")
  toPharmacyId   String         @map("to_pharmacy_id")
  requestNumber  String         @unique @map("request_number")
  status         TransferStatus @default(PENDING)
  requestedBy    String         @map("requested_by")
  approvedBy     String?        @map("approved_by")
  approvedAt     DateTime?      @map("approved_at")
  dispatchedAt   DateTime?      @map("dispatched_at")
  receivedAt     DateTime?      @map("received_at")
  receivedBy     String?        @map("received_by")
  notes          String?
  version        Int            @default(1)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  // Relations
  hospital     Hospital       @relation("HospitalTransfers", fields: [hospitalId], references: [id], onDelete: Cascade)
  fromPharmacy Pharmacy       @relation("FromPharmacy", fields: [fromPharmacyId], references: [id])
  toPharmacy   Pharmacy       @relation("ToPharmacy", fields: [toPharmacyId], references: [id])
  requester    User           @relation("TransferRequester", fields: [requestedBy], references: [id])
  approver     User?          @relation("TransferApprover", fields: [approvedBy], references: [id])
  receiver     User?          @relation("TransferReceiver", fields: [receivedBy], references: [id])
  items        TransferItem[]

  @@index([hospitalId])
  @@index([fromPharmacyId])
  @@index([toPharmacyId])
  @@index([status])
  @@index([hospitalId, status]) // Composite for common queries
  @@index([createdAt]) // For sorting by date
  @@index([fromPharmacyId, status]) // For source pharmacy filtering
  @@index([toPharmacyId, status]) // For destination pharmacy filtering
  @@index([hospitalId, createdAt]) // For hospital-specific date queries
  @@map("transfer_requests")
}

model TransferItem {
  id                String        @id @default(uuid())
  transferId        String        @map("transfer_id")
  medicineId        String        @map("medicine_id")
  qtyRequested      Int           @map("qty_requested")
  qtyApproved       Int?          @map("qty_approved")
  qtyDispatched     Int?          @map("qty_dispatched")
  qtyReceived       Int?          @map("qty_received")
  transferCategory  BatchCategory @default(NORMAL) @map("transfer_category")

  // Relations
  transferRequest TransferRequest        @relation(fields: [transferId], references: [id], onDelete: Cascade)
  medicine        Medicine               @relation(fields: [medicineId], references: [id])
  batchMappings   TransferBatchMapping[]

  @@index([transferId])
  @@map("transfer_items")
}

model TransferBatchMapping {
  id                 String  @id @default(uuid())
  transferItemId     String  @map("transfer_item_id")
  sourceBatchId      String  @map("source_batch_id")
  destinationBatchId String? @map("destination_batch_id")
  qty                Int

  // Relations
  transferItem     TransferItem @relation(fields: [transferItemId], references: [id], onDelete: Cascade)
  sourceBatch      StockBatch   @relation("SourceBatch", fields: [sourceBatchId], references: [id])
  destinationBatch StockBatch?  @relation("DestinationBatch", fields: [destinationBatchId], references: [id])

  @@index([transferItemId])
  @@map("transfer_batch_mappings")
}

// ============================================
// ALERTS & NOTIFICATIONS
// ============================================

model Alert {
  id             String        @id @default(uuid())
  hospitalId     String        @map("hospital_id")
  pharmacyId     String        @map("pharmacy_id")
  alertType      AlertType     @map("alert_type")
  severity       AlertSeverity
  message        String
  entityType     String?       @map("entity_type")
  entityId       String?       @map("entity_id")
  status         AlertStatus   @default(ACTIVE)
  acknowledgedBy String?       @map("acknowledged_by")
  acknowledgedAt DateTime?     @map("acknowledged_at")
  version        Int           @default(1)
  createdAt      DateTime      @default(now()) @map("created_at")
  resolvedAt     DateTime?     @map("resolved_at")

  // Relations
  hospital     Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  pharmacy     Pharmacy @relation(fields: [pharmacyId], references: [id])
  acknowledger User?    @relation(fields: [acknowledgedBy], references: [id])

  @@index([hospitalId])
  @@index([pharmacyId])
  @@index([alertType])
  @@index([status])
  @@map("alerts")
}

// ============================================
// AUDIT & SYNC
// ============================================

model AuditLog {
  id          String   @id @default(uuid())
  hospitalId  String   @map("hospital_id")
  userId      String   @map("user_id")
  action      String
  module      String?  // e.g. "Medicines", "Inventory", "Prescriptions"
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  description String?  // Human-readable summary of the action
  beforeState Json?    @map("before_state")
  afterState  Json?    @map("after_state")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  timestamp   DateTime @default(now())

  // Relations
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@index([hospitalId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([timestamp])
  @@index([module])
  @@map("audit_logs")
}

model SyncOperation {
  id                 String     @id @default(uuid())
  hospitalId         String     @map("hospital_id")
  pharmacyId         String     @map("pharmacy_id")
  operationType      String     @map("operation_type")
  entityType         String     @map("entity_type")
  entityId           String     @map("entity_id")
  payload            Json
  status             SyncStatus @default(PENDING)
  version            Int
  createdAt          DateTime   @default(now()) @map("created_at")
  syncedAt           DateTime?  @map("synced_at")
  conflictResolution Json?      @map("conflict_resolution")

  // Relations
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@index([hospitalId])
  @@index([pharmacyId])
  @@index([status])
  @@index([createdAt])
  @@map("sync_operations")
}

model SystemConfig {
  id          String   @id @default(uuid())
  hospitalId  String?  @map("hospital_id")
  configKey   String   @map("config_key")
  configValue Json     @map("config_value")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  hospital Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, configKey])
  @@map("system_configs")
}

// ============================================
// CLINICAL SERVICES - PHASE 2
// ============================================

// Clinic Model (OPD)
model Clinic {
  id                String       @id @default(uuid())
  hospitalId        String       @map("hospital_id")
  departmentId      String       @map("department_id")
  doctorId          String       @map("doctor_id")
  name              String // e.g., "Dr. Smith's Cardiology Clinic"
  opdFee            Decimal      @map("opd_fee") @db.Decimal(10, 2)
  availableDays     String[]     @map("available_days") // ["MONDAY", "WEDNESDAY", "FRIDAY"]
  availableFrom     String?      @map("available_from") // "09:00"
  availableTo       String?      @map("available_to") // "17:00"
  maxPatientsPerDay Int?         @map("max_patients_per_day")
  status            ClinicStatus @default(ACTIVE)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  // Relations
  hospital   Hospital   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  doctor     User       @relation("DoctorClinics", fields: [doctorId], references: [id], onDelete: Cascade)
  visits     Visit[]
  tokens     Token[]

  @@unique([hospitalId, departmentId, doctorId, name])
  @@index([hospitalId])
  @@index([departmentId])
  @@index([doctorId])
  @@index([status])
  @@map("clinics")
}

// Visit Model (OPD Visit/Consultation)
model Visit {
  id               String        @id @default(uuid())
  hospitalId       String        @map("hospital_id")
  patientId        String        @map("patient_id")
  clinicId         String?       @map("clinic_id")
  tokenId          String?       @map("token_id")
  registrarId      String        @map("registrar_id")
  consultantId     String?       @map("consultant_id")
  visitNumber      String        @unique @map("visit_number")
  visitType        VisitType     @map("visit_type")
  departmentId     String?       @map("department_id")
  wardId           String?       @map("ward_id")
  bedId            String?       @map("bed_id")
  attendingDoctorId String?      @map("attending_doctor_id")
  visitDate        DateTime      @default(now()) @map("visit_date")
  tokenNumber      Int?          @map("token_number")
  chiefComplaint   String?       @map("chief_complaint")
  historyOfIllness String?       @map("history_of_illness")
  examination      String?
  diagnosis        String?
  treatmentPlan    String?       @map("treatment_plan")
  vitalSigns       Json?         @map("vital_signs") // { bp, pulse, temp, spo2, weight, height }
  consultationFee  Decimal       @map("consultation_fee") @db.Decimal(10, 2)
  paymentStatus    PaymentStatus @default(UNPAID) @map("payment_status")
  status           VisitStatus   @default(WAITING)
  consultedAt      DateTime?     @map("consulted_at")
  completedAt      DateTime?     @map("completed_at")
  notes            String?
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  // Relations
  hospital   Hospital   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient    Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  clinic     Clinic?    @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  token      Token?     @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  registrar  User       @relation("VisitRegistrar", fields: [registrarId], references: [id])
  consultant User?      @relation("VisitConsultant", fields: [consultantId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  bed        Bed?       @relation(fields: [bedId], references: [id], onDelete: SetNull)
  attendingDoctor User? @relation("VisitAttendingDoctor", fields: [attendingDoctorId], references: [id], onDelete: SetNull)
  referrals              Referral[]
  receipts               Receipt[]
  admission              Admission?
  operations             Operation[]
  // Phase 3: Lab Services
  labOrders              LabOrder[]
  prescriptions          Prescription[]
  prescriptionDispatches PrescriptionDispatch[]

  @@unique([clinicId, visitDate, tokenNumber])
  @@index([hospitalId])
  @@index([patientId])
  @@index([clinicId])
  @@index([status])
  @@index([visitType])
  @@index([departmentId])
  @@index([bedId])
  @@index([attendingDoctorId])
  @@index([visitDate])
  @@index([paymentStatus])
  @@map("visits")
}

// Token Model (Queue Management)
model Token {
  id          String      @id @default(uuid())
  hospitalId  String      @map("hospital_id")
  clinicId    String      @map("clinic_id")
  tokenNumber Int         @map("token_number")
  tokenDate   DateTime    @default(now()) @map("token_date") @db.Date
  status      TokenStatus @default(WAITING)
  calledAt    DateTime?   @map("called_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  // Relations
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  clinic   Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  visits   Visit[]

  @@unique([clinicId, tokenDate, tokenNumber])
  @@index([hospitalId])
  @@index([clinicId])
  @@index([tokenDate])
  @@index([status])
  @@map("tokens")
}

// Referral Model
model Referral {
  id               String           @id @default(uuid())
  hospitalId       String           @map("hospital_id")
  visitId          String           @map("visit_id")
  fromDepartmentId String           @map("from_department_id")
  toDepartmentId   String           @map("to_department_id")
  referrerId       String           @map("referrer_id")
  referralType     ReferralType     @map("referral_type")
  priority         ReferralPriority @default(NORMAL)
  reason           String?
  notes            String?
  status           ReferralStatus   @default(PENDING)
  acceptedAt       DateTime?        @map("accepted_at")
  completedAt      DateTime?        @map("completed_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  // Relations
  hospital       Hospital   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  visit          Visit      @relation(fields: [visitId], references: [id], onDelete: Cascade)
  fromDepartment Department @relation("ReferralsFrom", fields: [fromDepartmentId], references: [id])
  toDepartment   Department @relation("ReferralsTo", fields: [toDepartmentId], references: [id])
  referrer       User       @relation("ReferralsMade", fields: [referrerId], references: [id])

  @@index([hospitalId])
  @@index([visitId])
  @@index([fromDepartmentId])
  @@index([toDepartmentId])
  @@index([status])
  @@map("referrals")
}

// Receipt Model (OPD, Lab, etc.)
model Receipt {
  id            String        @id @default(uuid())
  hospitalId    String        @map("hospital_id")
  patientId     String        @map("patient_id")
  visitId       String?       @map("visit_id")
  departmentId  String?       @map("department_id")
  generatedById String        @map("generated_by_id")
  receiptNumber String        @unique @map("receipt_number")
  receiptType   ReceiptType   @map("receipt_type")
  description   String?
  amount        Decimal       @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  tax           Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount   Decimal       @map("total_amount") @db.Decimal(10, 2)
  paidAmount    Decimal       @default(0) @map("paid_amount") @db.Decimal(10, 2)
  paymentMethod PaymentMethod @default(CASH) @map("payment_method")
  paymentStatus PaymentStatus @default(UNPAID) @map("payment_status")
  paidAt        DateTime?     @map("paid_at")
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  // Relations
  hospital    Hospital   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient     Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visit       Visit?     @relation(fields: [visitId], references: [id], onDelete: SetNull)
  department  Department? @relation(fields: [departmentId], references: [id])
  generatedBy User       @relation("ReceiptsGenerated", fields: [generatedById], references: [id])

  @@index([hospitalId])
  @@index([patientId])
  @@index([visitId])
  @@index([departmentId])
  @@index([receiptType])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("receipts")
}

// ============================================
// IN-HOUSE (INDOOR / ADMISSION) - PHASE 2
// ============================================

// Room Model
model Room {
  id           String     @id @default(uuid())
  hospitalId   String     @map("hospital_id")
  departmentId String?    @map("department_id")
  roomNumber   String     @map("room_number")
  roomType     RoomType   @map("room_type")
  floor        Int?
  building     String?
  capacity     Int        @default(1) // Number of beds
  dailyRate    Decimal    @map("daily_rate") @db.Decimal(10, 2)
  amenities    String[] // ["AC", "TV", "ATTACHED_BATH", "WIFI"]
  status       RoomStatus @default(AVAILABLE)
  notes        String?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  // Relations
  hospital   Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  beds       Bed[]
  admissions Admission[]

  @@unique([hospitalId, roomNumber])
  @@index([hospitalId])
  @@index([departmentId])
  @@index([roomType])
  @@index([status])
  @@map("rooms")
}

// Bed Model
model Bed {
  id           String    @id @default(uuid())
  hospitalId   String    @map("hospital_id")
  departmentId String?   @map("department_id")
  roomId       String?   @map("room_id")
  bedNumber    String    @map("bed_number")
  bedType      BedType   @map("bed_type")
  dailyRate    Decimal   @map("daily_rate") @db.Decimal(10, 2)
  features     String[] // ["ELECTRIC", "SIDE_RAILS", "IV_POLE"]
  status       BedStatus @default(AVAILABLE)
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  hospital   Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  room       Room?       @relation(fields: [roomId], references: [id], onDelete: SetNull)
  admissions Admission[]
  visits     Visit[]

  @@unique([hospitalId, bedNumber])
  @@index([hospitalId])
  @@index([departmentId])
  @@index([roomId])
  @@index([bedType])
  @@index([status])
  @@map("beds")
}

// Admission Model
model Admission {
  id                   String          @id @default(uuid())
  hospitalId           String          @map("hospital_id")
  patientId            String          @map("patient_id")
  visitId              String?         @unique @map("visit_id")
  departmentId         String          @map("department_id")
  roomId               String?         @map("room_id")
  bedId                String?         @map("bed_id")
  attendingDoctorId    String          @map("attending_doctor_id")
  admittingUserId      String          @map("admitting_user_id")
  dischargingUserId    String?         @map("discharging_user_id")
  admissionNumber      String          @unique @map("admission_number")
  admissionType        AdmissionType   @map("admission_type")
  admittedAt           DateTime        @default(now()) @map("admitted_at")
  dischargedAt         DateTime?       @map("discharged_at")
  expectedDischarge    DateTime?       @map("expected_discharge")
  diagnosisOnAdmission String?         @map("diagnosis_on_admission")
  diagnosisOnDischarge String?         @map("diagnosis_on_discharge")
  treatmentSummary     String?         @map("treatment_summary")
  dischargeSummary     String?         @map("discharge_summary")
  status               AdmissionStatus @default(ADMITTED)
  notes                String?
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  // Relations
  hospital        Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient         Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visit           Visit?        @relation(fields: [visitId], references: [id], onDelete: SetNull)
  department      Department    @relation(fields: [departmentId], references: [id])
  room            Room?         @relation(fields: [roomId], references: [id], onDelete: SetNull)
  bed             Bed?          @relation(fields: [bedId], references: [id], onDelete: SetNull)
  attendingDoctor User          @relation("AttendingAdmissions", fields: [attendingDoctorId], references: [id])
  admittingUser   User          @relation("AdmittingAdmissions", fields: [admittingUserId], references: [id])
  dischargingUser User?         @relation("DischargingAdmissions", fields: [dischargingUserId], references: [id])
  dailyCharges    DailyCharge[]
  operations      Operation[]

  @@index([hospitalId])
  @@index([patientId])
  @@index([departmentId])
  @@index([roomId])
  @@index([bedId])
  @@index([status])
  @@index([admittedAt])
  @@map("admissions")
}

// Daily Charge Model
model DailyCharge {
  id              String   @id @default(uuid())
  hospitalId      String   @map("hospital_id")
  admissionId     String   @map("admission_id")
  chargeDate      DateTime @map("charge_date") @db.Date
  roomCharges     Decimal  @default(0) @map("room_charges") @db.Decimal(10, 2)
  bedCharges      Decimal  @default(0) @map("bed_charges") @db.Decimal(10, 2)
  nursingCharges  Decimal  @default(0) @map("nursing_charges") @db.Decimal(10, 2)
  medicineCharges Decimal  @default(0) @map("medicine_charges") @db.Decimal(10, 2)
  otherCharges    Decimal  @default(0) @map("other_charges") @db.Decimal(10, 2)
  totalCharges    Decimal  @map("total_charges") @db.Decimal(10, 2)
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  hospital  Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  admission Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  @@unique([admissionId, chargeDate])
  @@index([hospitalId])
  @@index([admissionId])
  @@index([chargeDate])
  @@map("daily_charges")
}

// ============================================
// SURGERY / OPERATION MANAGEMENT - PHASE 2
// ============================================

model OperationTheatre {
  id           String                @id @default(uuid())
  hospitalId   String                @map("hospital_id")
  departmentId String?               @map("department_id")
  name         String
  code         String
  location     String?
  status       OperationTheatreStatus @default(ACTIVE)
  notes        String?
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  // Relations
  hospital   Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  operations Operation[]

  @@unique([hospitalId, code])
  @@index([hospitalId])
  @@index([departmentId])
  @@index([status])
  @@map("operation_theatres")
}

model Operation {
  id                        String               @id @default(uuid())
  hospitalId                String               @map("hospital_id")
  patientId                 String               @map("patient_id")
  patientType               OperationPatientType @map("patient_type")
  visitId                   String?              @map("visit_id")
  admissionId               String?              @map("admission_id")
  departmentId              String               @map("department_id")
  operationType             String               @map("operation_type")
  surgeonId                 String               @map("surgeon_id")
  theatreId                 String               @map("theatre_id")
  scheduledAt               DateTime             @map("scheduled_at")
  estimatedDurationMinutes  Int                  @default(60) @map("estimated_duration_minutes")
  emergencyFlag             Boolean              @default(false) @map("emergency_flag")
  operationPrice            Decimal?             @map("operation_price") @db.Decimal(10, 2)
  status                    OperationStatus      @default(SCHEDULED)
  notes                     String?
  preOpNotes                String?              @map("pre_op_notes")
  postOpNotes               String?              @map("post_op_notes")
  recoveryNotes             String?              @map("recovery_notes")
  followUpAt                DateTime?            @map("follow_up_at")
  startedAt                 DateTime?            @map("started_at")
  completedAt               DateTime?            @map("completed_at")
  cancelledAt               DateTime?            @map("cancelled_at")
  createdAt                 DateTime             @default(now()) @map("created_at")
  updatedAt                 DateTime             @updatedAt @map("updated_at")

  // Relations
  hospital   Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient    Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visit      Visit?           @relation(fields: [visitId], references: [id], onDelete: SetNull)
  admission  Admission?       @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  department Department       @relation(fields: [departmentId], references: [id])
  surgeon    User             @relation("OperationSurgeon", fields: [surgeonId], references: [id])
  theatre    OperationTheatre @relation(fields: [theatreId], references: [id])

  @@index([hospitalId])
  @@index([patientId])
  @@index([departmentId])
  @@index([surgeonId])
  @@index([theatreId])
  @@index([status])
  @@index([scheduledAt])
  @@map("operations")
}

