# Next.js Configuration
NEXT_PUBLIC_APP_NAME=M-IMS
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secure-nextauth-secret-key

# API Configuration
API_TIMEOUT=30000

# Feature Flags
NEXT_PUBLIC_OFFLINE_MODE_ENABLED=true
NEXT_PUBLIC_FIFO_VISUALIZATION_ENABLED=true
NEXT_PUBLIC_REAL_TIME_UPDATES_ENABLED=true

# Analytics
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_ANALYTICS_ID=

# Error Reporting
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Performance Monitoring
NEXT_PUBLIC_PERFORMANCE_MONITORING=false

# PWA Configuration
NEXT_PUBLIC_PWA_ENABLED=true

# Hospital Branding
NEXT_PUBLIC_HOSPITAL_NAME=General Hospital
NEXT_PUBLIC_HOSPITAL_LOGO=/images/hospital-logo.png
NEXT_PUBLIC_PRIMARY_COLOR=#1f2937
NEXT_PUBLIC_SECONDARY_COLOR=#3b82f6
