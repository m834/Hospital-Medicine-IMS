{
  "name": "mims-local-sync",
  "version": "1.0.0",
  "description": "Offline-first sync service for Hospital Medicine IMS sub-pharmacy facilities",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start:prod": "npm run build && node dist/index.js",
    "install:service": "node scripts/install-service.js",
    "reset:queue": "node scripts/reset-queue.js",
    "unlock:queue": "node scripts/unlock-queue.js",
    "test": "jest",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "sync",
    "offline-first",
    "hospital",
    "pharmacy",
    "inventory"
  ],
  "author": "M-IMS Team",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.6.0",
    "node-fetch": "^3.3.2",
    "winston": "^3.17.0",
    "dotenv": "^16.4.7",
    "axios": "^1.7.9",
    "cron": "^3.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.14",
    "eslint": "^9.16.0",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0"
  }
}
