# Local Sync Service Configuration
NODE_ENV=development
PORT=3002

# Main API Configuration
MAIN_API_URL=http://localhost:3001/api/v1
API_KEY=your-sync-service-api-key

# Local Database Configuration (SQLite)
LOCAL_DB_PATH=./database/local.db
LOCAL_DB_BACKUP_PATH=./database/backups/

# Sync Configuration
SYNC_ENABLED=true
SYNC_INTERVAL_MINUTES=15
BATCH_SIZE=100
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_MS=5000

# Conflict Resolution
CONFLICT_RESOLUTION_STRATEGY=last_write_wins
MANUAL_RESOLUTION_REQUIRED_FOR=prescriptions,transfers

# Hospital Configuration
HOSPITAL_ID=1
PHARMACY_ID=1

# Security
ENCRYPTION_KEY=your-32-character-encryption-key
API_TOKEN=your-local-sync-api-token

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/sync.log

# Network Configuration
NETWORK_TIMEOUT_MS=30000
CONNECTION_RETRY_INTERVAL_MS=60000

# Data Retention
LOCAL_DATA_RETENTION_DAYS=30
SYNC_LOG_RETENTION_DAYS=7
