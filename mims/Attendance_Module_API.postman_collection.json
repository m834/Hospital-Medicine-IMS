      "name": "1. Biometric Devices",
      "description": "Device registration, management, and status monitoring",
      "item": [
        {
          "name": "Register Device",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('device_id', jsonData.id);",
                  "    pm.test('Device registered successfully', function () {",
                  "        pm.expect(jsonData).to.have.property('id');",
                  "        pm.expect(jsonData.status).to.equal('ACTIVE');",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Device 1 - Reception\",\n  \"deviceType\": \"FINGERPRINT\",\n  \"serialNumber\": \"ZKT-001-2026\",\n  \"ipAddress\": \"192.168.1.100\",\n  \"port\": 4370,\n  \"location\": \"Reception Area\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/biometric-devices",
              "host": ["{{base_url}}"],
              "path": ["biometric-devices"]
            },
            "description": "Register a new biometric device (fingerprint, face, etc.)"
          },
          "response": []
        },
        {
